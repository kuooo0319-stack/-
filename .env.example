# 這個檔案是給「不想每次開網頁都填設定」的人用的預設值，
# 網頁上的設定畫面一樣可以隨時覆蓋這裡的內容。
# 本機使用：複製這個檔案為 .env 並依需求修改（需要 python-dotenv，requirements.txt 已包含）。
# 雲端部署（Render 等）：不要上傳 .env，改在主機服務商的「環境變數 / Environment」
# 設定畫面裡，把下面同樣的變數一個一個加進去。

# provider 可填：anthropic / openai / custom
SCRIPT_BREAKER_PROVIDER=anthropic

# 金鑰：SCRIPT_BREAKER_API_KEY 對任何 provider 都通用，建議直接用這個。
# ANTHROPIC_API_KEY / OPENAI_API_KEY 是額外備援，方便沿用習慣命名。
SCRIPT_BREAKER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 選填：指定模型
SCRIPT_BREAKER_MODEL=

# 選填：只有 provider=custom（例如 Gemini/DeepSeek/Kimi/自架服務）才需要
SCRIPT_BREAKER_BASE_URL=

# ── 以下兩個只有部署到公開網址時才需要 ──────────────────────────────

# 設定這個之後，網頁會要求輸入密碼才能使用，避免網址外流被別人用你的 API 額度。
# 本機用「啟動.bat」執行時請不要設定，才不會多一道登入手續。
SCRIPT_BREAKER_PASSWORD=

# 任意一串隨機字串即可，用來簽章登入的 session。設定後重新部署/重啟服務時，
# 大家不用重新輸入密碼；不設的話每次重啟都要重新登入一次（本機使用不受影響）。
SCRIPT_BREAKER_SECRET_KEY=
